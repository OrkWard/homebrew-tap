# GitHub Actions uses repository secrets MINIO_ACCESS_KEY and MINIO_SECRET_KEY,
# plus repository variables MINIO_ENDPOINT, BOTTLE_ROOT and BOTTLE_TARGET.
# MINIO_ENDPOINT is the same server URL used by the local mc alias.

# Where published bottles are served from. This URL ends up in the formula's
# bottle block, so it must be reachable by anyone installing from this tap.
BOTTLE_ROOT=https://bottles.example.com/bottles

# mc alias and bucket the bottles are uploaded to (see `mc alias list`).
BOTTLE_TARGET=myalias/bottles
